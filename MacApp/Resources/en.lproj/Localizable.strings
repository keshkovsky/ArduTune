"-- %@\n-- Скрипт ArduPilot Lua. Виконується щосекунди.\nlocal RC_OPTION = 300   -- Scripting 1: призначте канал пульта слоту Scripting 1\n\nfunction update()\n  local ch = rc:find_channel_for_option(RC_OPTION)\n  if ch then\n    local pos = ch:get_aux_switch_pos()   -- 0 = LOW, 1 = MID, 2 = HIGH\n    gcs:send_text(6, \"Switch position: \" .. tostring(pos))\n  end\n  return update, 1000\nend\n\nreturn update, 1000" = "-- %@\n-- ArduPilot Lua script. Runs every second.\nlocal RC_OPTION = 300   -- Scripting 1: assign a transmitter channel to the Scripting 1 slot\n\nfunction update()\n  local ch = rc:find_channel_for_option(RC_OPTION)\n  if ch then\n    local pos = ch:get_aux_switch_pos()   -- 0 = LOW, 1 = MID, 2 = HIGH\n    gcs:send_text(6, \"Switch position: \" .. tostring(pos))\n  end\n  return update, 1000\nend\n\nreturn update, 1000";
